# ─── IrfanLM Relay Server — Environment Variables ───────────────────────────
# Copy this file to .env for local dev. In Railway, set these as Variables.

# REQUIRED — shared secret between extension and server
# Generate a random string: e.g. openssl rand -hex 32
AUTH_SECRET=change_this_to_a_long_random_string

# ── TELEGRAM ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram chat/channel ID (use @username or numeric ID)
TELEGRAM_CHAT_ID=your_chat_id_here

# ── CLOUDINARY (optional) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SERVER ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not change this line
PORT=3000
